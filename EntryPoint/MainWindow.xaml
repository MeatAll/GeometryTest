<Window x:Class="GeometryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeometryApp"
        xmlns:interfaces="clr-namespace:GeometryApp.Interfaces"
        d:DataContext="{d:DesignInstance Type=interfaces:IViewModel}"
        PreviewKeyDown="Window_PreviewKeyDown"
        mc:Ignorable="d"
        Title="Geometry shapes draw" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <StackPanel>
        <Border Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Tooltip}" VerticalAlignment="Center"/>

                <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" IsEnabled="{Binding IsPaletteEnabled}">
                    <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Palette}" VerticalAlignment="Top" Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="1" Content="{Binding ButtonText}" Command="{Binding CreateCommand}" Height="50"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Clear" Height="40" Margin=" 1 1 7 1" Command="{Binding ClearCommand}"/>
                </StackPanel>

                <ItemsControl x:Name ="itemsControl" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GeometryShapes}" VerticalAlignment="Stretch" 
                              Background="#FFF0F0F0" PreviewMouseLeftButtonDown="ItemsControlClickHandler">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid Width="700" Height="700"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Path Data="{Binding}" Stretch="None" Stroke="CornflowerBlue" StrokeThickness="2" ClipToBounds="True"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>
    </StackPanel>
</Window>
